# Copy to backend/.env (git-ignored). Values here override shell environment variables.
# Never put the Gemini key in frontend/.env: VITE_ variables are bundled into public JavaScript.

# Comma-separated list of allowed frontend origins ("*" is ignored).
# Unset = any localhost/127.0.0.1 port is allowed. Set a list only for other origins (it replaces that default).
# SPACESENSE_CORS_ORIGINS=https://your-frontend.example

# Providers: analysis (also drives the chat) = rule_based | gemini, design (photo editing) = mock | gemini
SPACESENSE_ANALYSIS_PROVIDER=rule_based
SPACESENSE_DESIGN_PROVIDER=mock

# Required when either provider is "gemini". Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Products: catalog (default, works offline) | serpapi (live Google Shopping results, then the catalog)
SPACESENSE_PRODUCT_PROVIDER=catalog
# Required when SPACESENSE_PRODUCT_PROVIDER=serpapi. Get one at https://serpapi.com (free monthly quota)
SERPAPI_API_KEY=

# AI image generation (Cloudflare Workers AI, free tier: 10,000 Neurons/day). Leave empty to disable it.
# Account ID: Cloudflare dashboard > Workers & Pages (right sidebar). Token: My Profile > API Tokens >
# Create Token > "Workers AI" template. Keep both on the backend only.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Accounts (SQLite file at backend/data/spacesense.db, git-ignored).
# Where the frontend is served. Verification and reset links in emails point here.
SPACESENSE_FRONTEND_URL=http://localhost:5173
# Set to true when the site is served over HTTPS so the session cookie is only sent over HTTPS.
# SPACESENSE_COOKIE_SECURE=true

# Email for verification and password-reset links. Leave SMTP_HOST empty in development: the links are
# then printed in the backend log instead of being sent. Always configure it in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sign in with Google. Create an OAuth client (Web application) at https://console.cloud.google.com/apis/credentials
# and add this redirect URI to it: <SPACESENSE_API_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SPACESENSE_API_URL=http://localhost:8000

# Optional overrides
# SPACESENSE_IMAGEGEN_RATE_PER_MIN=5
# SPACESENSE_IMAGEGEN_TIMEOUT_S=60
# SPACESENSE_GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
# SPACESENSE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Model for the designer's "Arrange with AI" (text only, so a free-tier model works). Defaults to the analysis model.
# SPACESENSE_GEMINI_LAYOUT_MODEL=gemini-3.5-flash-lite
# SPACESENSE_LAYOUT_RATE_PER_MIN=6
# SPACESENSE_GEMINI_TIMEOUT_S=90
# SPACESENSE_MAX_UPLOAD_MB=10
