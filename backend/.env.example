# Copy to backend/.env for local overrides. Never commit real secrets.
# Note: the app reads these from the process environment; set them in your shell
# (or load this file with your tooling) before starting uvicorn.

# Comma-separated list of allowed frontend origins ("*" is ignored).
SPACESENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Providers. Only "rule_based" (analysis) and "mock" (design) exist today.
SPACESENSE_ANALYSIS_PROVIDER=rule_based
SPACESENSE_DESIGN_PROVIDER=mock

# Reserved for future AI providers (not read by the current code):
# GEMINI_API_KEY=
